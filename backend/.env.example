PORT=4000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=turesma_db
DB_PASSWORD=replace_with_local_database_password
DB_PORT=5432
DB_SSL=false
DATABASE_URL=

# Recuperacion de contraseña por correo (SMTP)
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=Turesma <your_email@example.com>
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_PIN_TTL_MINUTES=10

# PayPal REST API: usa sandbox para pruebas y live para cobros reales
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
WEB_URL=http://localhost:3000
