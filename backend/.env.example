PORT=4000
# Configura el mismo secreto aleatorio que en web/.env
JWT_SECRET=replace_with_one_shared_random_secret
JWT_EXPIRES_IN=7d
DB_USER=postgres
DB_HOST=localhost
DB_NAME=turesma_db
DB_PASSWORD=replace_with_local_database_password
DB_PORT=5432
DB_SSL=false
DATABASE_URL=

# Recuperacion de contraseña por correo (SMTP)
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=Turesma <your_email@example.com>
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_PIN_TTL_MINUTES=10

# PayPhone Button/Prepare. El token y el StoreID se obtienen en PayPhone Developers.
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_TOKEN=replace_with_payphone_token
PAYPHONE_STORE_ID=replace_with_payphone_store_id
WEB_URL=http://localhost:3000
